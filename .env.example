# ---------------------------------------------------------------------------
# Dev local (DJANGO_SETTINGS_MODULE=config.settings.dev)
# ---------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=bjt_goi
DB_USER=bjt_goi_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------------------
# Supabase (DJANGO_SETTINGS_MODULE=config.settings.supabase)
# Lay chuoi o Dashboard > Connect. Ba lua chon:
#
#   Direct       postgresql://postgres:[PW]@db.<ref>.supabase.co:5432/postgres
#                -> IPv6 mac dinh; mang khong co IPv6 se khong noi duoc
#   Session      postgresql://postgres.<ref>:[PW]@aws-0-<region>.pooler.supabase.com:5432/postgres
#                -> IPv4, co prepared statement. DUNG CAI NAY DE MIGRATE
#   Transaction  postgresql://postgres.<ref>:[PW]@aws-0-<region>.pooler.supabase.com:6543/postgres
#                -> IPv4, KHONG prepared statement. Dung cho runtime serverless
#
# Mat khau co ky tu dac biet phai URL-encode (@ -> %40, # -> %23, / -> %2F).
# KHONG commit file .env that - .gitignore da loai tru san.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# Chi can khi chay scripts/deploy_supabase.py --superuser
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
